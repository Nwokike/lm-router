# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tooling caches
.ruff_cache/
.pytest_cache/

# App runtime state (dev runs from repo root)
app_settings.json
app_settings.json.bak
engine_local.py
providers.json
conversations/
logs.json
lm-router.log*
tiktoken_cache/
master.key
smoke_debug.py

# ZCode session scratch (plans, local state) — not part of the project
.zcode/

# Signing keystore — CI writes this file to the repo root (build-all.yml
# Decode Keystore); all three reference repos ignore it. Committing it would
# publish the Play Store upload key.
kiri_keystore.jks
upload-key.jks

# OS / tooling debris
.DS_Store
Thumbs.db
*.spec

# Local runtime + scratch (declared, not incidental — the audit found state
# scattered by CWD-relative paths)
cache/
.tmpw/
*.log

